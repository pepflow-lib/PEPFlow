  "lamb_code": "import math\nimport operator\nimport numpy as np\n\ndef candidate(N):\n    N = operator.index(N)\n    if N < 1:\n        raise ValueError('N must be a positive integer')\n    theta = [1.0]\n    for _ in range(N):\n        theta.append((1 + math.sqrt(1 + 4 * theta[-1] ** 2)) / 2)\n    h = np.zeros((N + 1, N + 1))\n    for i in range(N):\n        h[i + 1, :i] = (1 - 1 / theta[i + 1]) * h[i, :i] + np.array(theta[:i]) / theta[i + 1]\n        h[i + 1, i] = 1 + (theta[i] - 1) / theta[i + 1]\n    D = h.sum(axis=1)\n    delta = np.diff(D)\n    beta = np.zeros(N + 1)\n    alpha = np.zeros(N)\n    for j in range(N):\n        beta[j] = (h[N, j] + (alpha[j - 1] * delta[j - 1] if j else 0)) / (2 * D[N] - D[j])\n        alpha[j] = beta[:j + 1].sum()\n    beta[N] = 1 - alpha[N - 1]\n    alpha_closed = np.cumsum(h[N, :N]) / (2 * D[N] - D[:N])\n    assert np.max(np.abs(alpha - alpha_closed)) < 1e-12\n    eye = np.eye(N + 1)\n    A = np.diag(beta / 2)\n    for j in range(N + 1):\n        A += beta[j] * (np.outer(eye[j], h[j]) + np.outer(h[j], eye[j])) / 2\n    for i in range(N):\n        d = h[i + 1] - h[i]\n        e = eye[i] - eye[i + 1]\n        A += alpha[i] * (np.outer(eye[i + 1], d) + np.outer(d, eye[i + 1]) + np.outer(e, e)) / 2\n    q = 2 * D[N] + 1\n    B = A - q / 2 * np.outer(beta, beta)\n    S = np.block([[np.array([[1 / (2 * q)]]), -beta[None, :] / 2], [-beta[:, None] / 2, A]])\n    return dict(N=N, theta=theta, h=h, D=D, alpha=alpha, beta=beta, A=A, B=B, S=S)",
  "S_code": "import math\nimport operator\nimport numpy as np\n\ndef candidate(N):\n    N = operator.index(N)\n    if N < 1:\n        raise ValueError('N must be a positive integer')\n    theta = [1.0]\n    for _ in range(N):\n        theta.append((1 + math.sqrt(1 + 4 * theta[-1] ** 2)) / 2)\n    h = np.zeros((N + 1, N + 1))\n    for i in range(N):\n        h[i + 1, :i] = (1 - 1 / theta[i + 1]) * h[i, :i] + np.array(theta[:i]) / theta[i + 1]\n        h[i + 1, i] = 1 + (theta[i] - 1) / theta[i + 1]\n    D = h.sum(axis=1)\n    delta = np.diff(D)\n    beta = np.zeros(N + 1)\n    alpha = np.zeros(N)\n    for j in range(N):\n        beta[j] = (h[N, j] + (alpha[j - 1] * delta[j - 1] if j else 0)) / (2 * D[N] - D[j])\n        alpha[j] = beta[:j + 1].sum()\n    beta[N] = 1 - alpha[N - 1]\n    alpha_closed = np.cumsum(h[N, :N]) / (2 * D[N] - D[:N])\n    assert np.max(np.abs(alpha - alpha_closed)) < 1e-12\n    eye = np.eye(N + 1)\n    A = np.diag(beta / 2)\n    for j in range(N + 1):\n        A += beta[j] * (np.outer(eye[j], h[j]) + np.outer(h[j], eye[j])) / 2\n    for i in range(N):\n        d = h[i + 1] - h[i]\n        e = eye[i] - eye[i + 1]\n        A += alpha[i] * (np.outer(eye[i + 1], d) + np.outer(d, eye[i + 1]) + np.outer(e, e)) / 2\n    q = 2 * D[N] + 1\n    B = A - q / 2 * np.outer(beta, beta)\n    S = np.block([[np.array([[1 / (2 * q)]]), -beta[None, :] / 2], [-beta[:, None] / 2, A]])\n    return dict(N=N, theta=theta, h=h, D=D, alpha=alpha, beta=beta, A=A, B=B, S=S)\n\ndef original_basis_matrix(data, L=1.0):\n    \"\"\"Return S for [x_0, x_star, g_0, ..., g_N] with unscaled gradients.\"\"\"\n    N = data['N']\n    translated = data['S'].copy()\n    translated[0, 0] *= L\n    translated[1:, 1:] /= L\n    transform = np.zeros((N + 2, N + 3))\n    transform[0, 0], transform[0, 1] = 1.0, -1.0\n    transform[1:, 2:] = np.eye(N + 1)\n    return transform.T @ translated @ transform",
