  "certificate_check_source": "def inventory(ctx, pb):\n    entries = [(c, 'initial', None, None) for c in pb.init_conditions]\n    for owner in ctx.func_to_triplets:\n        groups = ctx.get_constraint_data(owner)\n        entries.extend((c, 'interpolation', str(owner), str(group))\n                       for group, constraints in groups.sc_dict.items() for c in constraints)\n        entries.extend((c, 'interpolation', str(owner), str(group)) for group, c in groups.psd_dict.items())\n    return entries\n\ndef residual_of(c):\n    residual = c.lhs-c.rhs\n    return -residual if c.cmp in (Comparator.GE,Comparator.SEQ) else residual\n\ndef verify(data, dense_value, decomposition=None):\n    ctx,pb,_ = setup.get_pep_setup(data['N'],json.loads(data['params_json']))\n    if data['relaxed_constraints']:\n        pb.set_relaxed_constraints(data['relaxed_constraints'])\n    for func in ctx.func_to_triplets:\n        func.get_interpolation_constraints(ctx)\n    entries = inventory(ctx,pb)\n    assert set(data['constraint_metadata']) == {c.name for c,*_ in entries}\n    assert data['basis_vectors'] == [str(v) for v in ctx.basis_vectors()]\n    assert data['basis_scalars'] == [str(v) for v in ctx.basis_scalars()]\n    pm = pf.ExpressionManager(ctx,resolve_parameters={'L':sp.S.One,'R':sp.S.One})\n    weighted=pf.Scalar.zero()\n    vals=[]\n    for c,*_ in entries:\n        value=data['named_dual_values'][c.name]\n        if c.name in pb.relaxed_constraints:\n            assert value is None\n            continue\n        assert isinstance(c,pf.ScalarConstraint), 'This PGM sample has only scalar constraints'\n        weighted += float(value)*(pf.Scalar.zero()+residual_of(c))\n        if c.cmp != Comparator.EQ:\n            vals.append(float(value))\n    basis=ctx.basis_vectors()\n    S=np.asarray(data['S_matrix'],dtype=float)\n    S_scalar=sum((float(S[i,j])*basis[i]*basis[j] for i,j in np.ndindex(S.shape)),pf.Scalar.zero())\n    checked=pm.eval_scalar(pb.performance_metric-data['opt_value']-weighted+S_scalar)\n    def ma(v):\n        return float(np.max(np.abs(np.asarray(v,dtype=float)),initial=0.0))\n    reconstruction=S if decomposition is None else np.asarray(decomposition['ell_coords']).T@np.asarray(decomposition['D'])@np.asarray(decomposition['ell_coords'])\n    residuals=dict(identity_gram_max_abs=ma(checked.inner_prod_coords),identity_func_max_abs=ma(checked.func_coords),identity_offset_abs=ma(checked.offset),\n                   S_reconstruction_max_abs=ma(reconstruction-S),dense_relaxed_gap=abs(data['opt_value']-dense_value),\n                   minimum_scalar_inequality_dual=min(vals,default=0.0),minimum_S_eigenvalue=float(np.linalg.eigvalsh((S+S.T)/2).min()),\n                   minimum_matrix_inequality_eigenvalue=0.0,candidate_rate_gap=abs(data['opt_value']-1/(4*data['N'])))\n    passed=data['certificate_provenance']['solver_status']=='optimal' and np.all(np.isfinite(S)) and np.allclose(S,S.T,atol=1e-6,rtol=0)\n    passed=passed and all(residuals[k]<=1e-5 for k in ('identity_gram_max_abs','identity_func_max_abs','identity_offset_abs','dense_relaxed_gap','candidate_rate_gap'))\n    passed=passed and np.allclose(reconstruction,S,atol=1e-4,rtol=1e-5) and residuals['minimum_scalar_inequality_dual']>=-1e-6 and residuals['minimum_S_eigenvalue']>=-1e-6\n    return dict(tolerances=TOL,residuals=residuals,passed=bool(passed)),ctx,pb,checked\n",
