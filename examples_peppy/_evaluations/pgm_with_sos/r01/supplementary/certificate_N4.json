  "lamb_code": "\"\"\"Exact candidate formulas derived from this attempt's sparse certificate.\"\"\"\nimport pepflow as pf\nimport sympy as sp\n\n\ndef aid_pieces(ctx, f, g, L, N):\n    n = sp.S(N)\n    pieces = []\n    for j in range(1, int(N) + 1):\n        i = sp.S(j)\n        xp, x, xs = ctx[f\"x_{j-1}\"], ctx[f\"x_{j}\"], ctx[\"x_star\"]\n        ap, a, astar, s = f.grad(xp), f.grad(x), f.grad(xs), g.grad(x)\n        c1 = n / ((2*n+1-i)*(2*n-i)) / L\n        u1 = i/(2*n)*a + (2*n-i)/(2*n)*ap - astar\n        c2 = ((i-1)/(2*n-i)*(2*n+2)/(2*n+1) + 2*n/((2*n-i)**2*(2*n+1))) / (2*L)\n        u2 = ap+s-L/(2*n+1-i)*(xp-xs)\n        c3 = i/(2*n+1-i)*(2*n)/(2*n+1)/(2*L)\n        u3 = (2*n+1)/(2*n)*(a+s)-(ap+s)/(2*n)-L/(2*n-i)*(x-xs)\n        pieces.extend([(j, 'u1', c1, u1), (j, 'u2', c2, u2), (j, 'u3', c3, u3)])\n    return pieces\n\n\ndef multiplier_candidate(name, N):\n    n = sp.S(N)\n    if name == 'initial_condition':\n        return sp.Rational(1, 4)/n\n    owner, pair = name.split(':')\n    row, col = pair.split(',')\n    if col == 'x_star':\n        return sp.S.Zero\n    j = sp.S(int(col[2:]))\n    if row == 'x_star':\n        if owner == 'f':\n            if j == 0:\n                return 1/(2*n)\n            if j == n:\n                return 1/(n+1)\n            return (2*n+1)/((2*n-j)*(2*n+1-j))\n        if j == n:\n            return 2/(n+1)\n        return 2*n/((2*n-j)*(2*n+1-j))\n    i = sp.S(int(row[2:]))\n    if j != i+1:\n        return sp.S.Zero\n    return (i+1)/(2*n-i) if owner == 'f' else i/(2*n-i)\n\n\ndef square_sum(pieces):\n    return sum((c*u**2 for _, _, c, u in pieces), pf.Scalar.zero())\n",
  "S_code": "\"\"\"Exact candidate formulas derived from this attempt's sparse certificate.\"\"\"\nimport pepflow as pf\nimport sympy as sp\n\n\ndef aid_pieces(ctx, f, g, L, N):\n    n = sp.S(N)\n    pieces = []\n    for j in range(1, int(N) + 1):\n        i = sp.S(j)\n        xp, x, xs = ctx[f\"x_{j-1}\"], ctx[f\"x_{j}\"], ctx[\"x_star\"]\n        ap, a, astar, s = f.grad(xp), f.grad(x), f.grad(xs), g.grad(x)\n        c1 = n / ((2*n+1-i)*(2*n-i)) / L\n        u1 = i/(2*n)*a + (2*n-i)/(2*n)*ap - astar\n        c2 = ((i-1)/(2*n-i)*(2*n+2)/(2*n+1) + 2*n/((2*n-i)**2*(2*n+1))) / (2*L)\n        u2 = ap+s-L/(2*n+1-i)*(xp-xs)\n        c3 = i/(2*n+1-i)*(2*n)/(2*n+1)/(2*L)\n        u3 = (2*n+1)/(2*n)*(a+s)-(ap+s)/(2*n)-L/(2*n-i)*(x-xs)\n        pieces.extend([(j, 'u1', c1, u1), (j, 'u2', c2, u2), (j, 'u3', c3, u3)])\n    return pieces\n\n\ndef multiplier_candidate(name, N):\n    n = sp.S(N)\n    if name == 'initial_condition':\n        return sp.Rational(1, 4)/n\n    owner, pair = name.split(':')\n    row, col = pair.split(',')\n    if col == 'x_star':\n        return sp.S.Zero\n    j = sp.S(int(col[2:]))\n    if row == 'x_star':\n        if owner == 'f':\n            if j == 0:\n                return 1/(2*n)\n            if j == n:\n                return 1/(n+1)\n            return (2*n+1)/((2*n-j)*(2*n+1-j))\n        if j == n:\n            return 2/(n+1)\n        return 2*n/((2*n-j)*(2*n+1-j))\n    i = sp.S(int(row[2:]))\n    if j != i+1:\n        return sp.S.Zero\n    return (i+1)/(2*n-i) if owner == 'f' else i/(2*n-i)\n\n\ndef square_sum(pieces):\n    return sum((c*u**2 for _, _, c, u in pieces), pf.Scalar.zero())\n",
