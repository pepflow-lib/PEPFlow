  "certificate_check_code": "import numpy as np\nimport pepflow as pf\nfrom pepflow.constraint import ScalarConstraint\nfrom pepflow.utils import Comparator\nfrom certificate_checks import verify_certificate, certificate_digest\n\nassert certificate_digest(certificate) == certificate['certificate_id']\nassert certificate['closed_form_search']['completed']\nassert certificate['certificate_provenance']['pep_type'] == 'primal'\nctx, pb, pm, checked, _, _, _, fresh_checks = verify_certificate(certificate)\nN_int = certificate['N_verify']\npb.set_relaxed_constraints(certificate['relaxed_constraints'])\nassert certificate['params_json'] == '{\"L\": 1, \"R\": 1}'\nassert certificate['normalization']['initial_condition'] == '||x_0-x_star||^2 <= R^2'\nassert certificate['normalization']['performance_metric'] == 'f(x_N) - f(x_star)'\nassert certificate['normalization']['tau_name'] == 'initial_condition'\nassert abs(certificate['normalization']['bound_value']-certificate['opt_value']) < 1e-5\nassert abs(certificate['named_dual_values']['initial_condition']-certificate['tau_sol']) < 1e-6\nbasis = list(ctx.basis_vectors())\nS_array = np.asarray(certificate['S_matrix'], dtype=float)\nS_scalar = sum((float(S_array[i,j])*basis[i]*basis[j] for i,j in np.ndindex(S_array.shape)), pf.Scalar.zero())\nrecords = [(c,'initial',None,None) for c in pb.init_conditions]\nassert not ctx.oper_to_duplets\nfor owner in ctx.func_to_triplets:\n    data = ctx.get_constraint_data(owner)\n    assert not data.psd_dict\n    records.extend((c,'interpolation',str(owner),str(group)) for group, family in data.sc_dict.items() for c in family)\nweighted_terms, group_terms, interpolation_pairs = {}, {}, {}\nfor con, origin, owner_name, group in records:\n    assert isinstance(con, ScalarConstraint)\n    meta = dict(origin=origin,owner=owner_name,group=group,kind='scalar',comparator=con.cmp.value,shape=[],relaxed=con.name in pb.relaxed_constraints)\n    assert meta == certificate['constraint_metadata'][con.name]\n    val = certificate['named_dual_values'][con.name]\n    if meta['relaxed']:\n        assert val is None\n        continue\n    assert val is not None\n    r = con.lhs - con.rhs\n    if con.cmp in (Comparator.GE, Comparator.SEQ):\n        r = -r\n    weighted_terms[con.name] = float(val)*r\n    if origin == 'interpolation':\n        group_terms[con.name] = weighted_terms[con.name]\n        interpolation_pairs[con.name] = tuple(con.name.split(':')[1].split(','))\nassert set(weighted_terms) - set(group_terms) == {'initial_condition'}\nraw_diff = pb.performance_metric-certificate['opt_value']-sum(weighted_terms.values(),pf.Scalar.zero())+S_scalar\n\ndef coords_max(expression):\n    value = pm.eval_scalar(expression)\n    return [float(np.max(np.abs(np.asarray(part,dtype=float)),initial=0)) for part in (value.inner_prod_coords,value.func_coords,value.offset)]\n\nassert max(coords_max(raw_diff)) < 1e-5\ncertificate_checked = True\nextra_duals = {}\n",
  "decomposition_code": "D = np.asarray(certificate['numerical_decomposition']['D'], dtype=float)\nE = np.asarray(certificate['numerical_decomposition']['ell_coords'], dtype=float)\nassert certificate['numerical_decomposition']['basis_labels'] == certificate['basis_vectors']\nell = [sum((float(coef)*v for coef,v in zip(row,basis)),pf.Vector.zero()) for row in E]\nassert D.shape == (1,1) and float(D[0,0]) > 0\nS_piece_terms = {'terminal_square': float(D[0,0])*ell[0]**2}\nassert max(coords_max(sum(S_piece_terms.values(),pf.Scalar.zero())-S_scalar)) < 1e-5\nfor piece in S_piece_terms.values():\n    value = pm.eval_scalar(piece)\n    assert np.min(np.linalg.eigvalsh(np.asarray(value.inner_prod_coords,dtype=float))) > -1e-6\n    assert np.max(np.abs(np.asarray(value.func_coords,dtype=float)),initial=0) < 1e-5\n    assert abs(float(value.offset)) < 1e-5\n",
  "grouping_code": "# Each assigned weighted interpolation residual is <= 0, so V is nonincreasing.\n# The single nonnegative S square is left for the final boundary argument.\nterm_assignment = {}\nfor name,(left,right) in interpolation_pairs.items():\n    j = 0 if right == 'z_0' else int(right.split('_')[1])\n    term_assignment[name] = -1 if j == 0 else j-1\nS_assignment = {'terminal_square': 'boundary'}\nassert set(term_assignment) == set(group_terms)\nassert set(S_assignment) == set(S_piece_terms)\nlyap = [pf.Scalar.zero()]\npartial_sum = sum((group_terms[name] for name,target in term_assignment.items() if target == -1),pf.Scalar.zero())\nfor step in range(N_int):\n    partial_sum += sum((group_terms[name] for name,target in term_assignment.items() if target == step),pf.Scalar.zero())\n    lyap.append(partial_sum)\nrank_tolerance = 1e-4\nrank_left,rank_right = 1,1\nranks, singular_values = [],[]\nfor k,Vk in enumerate(lyap):\n    matrix = np.asarray(pm.eval_scalar(Vk).inner_prod_coords,dtype=float)\n    singular_values.append(np.linalg.svd(matrix,compute_uv=False).tolist())\n    ranks.append(int(np.linalg.matrix_rank(matrix,tol=rank_tolerance)))\n    print(f'rank V_{k}: {ranks[-1]}')\n    if k == 0:\n        print()\nretained_ranks = ranks[rank_left:N_int+1-rank_right]\nprint('Interior rank is constant at this N:',len(retained_ranks)>=3 and len(set(retained_ranks))==1,'boundary exclusions:',(rank_left,rank_right))\nboundary_names = []\nboundary_S = ['terminal_square']\nleftover = -S_piece_terms['terminal_square']\ncoverage = lyap[N_int]+leftover-(sum(group_terms.values(),pf.Scalar.zero())-S_scalar)\ncoverage_residual = coords_max(coverage)\nassert max(coverage_residual) < 1e-5\nfor k in range(N_int):\n    targets = {-1,0} if k == 0 else {k}\n    increment = sum((group_terms[name] for name,target in term_assignment.items() if target in targets),pf.Scalar.zero())\n    assert max(coords_max(lyap[k+1]-lyap[k]-increment)) < 1e-5\nrank_credible = all(not any(rank_tolerance/10 <= s <= rank_tolerance*10 for s in values) for values in singular_values)\ngrouping_checked = True\n",
