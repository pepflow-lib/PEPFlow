  "certificate_check_code": "\"\"\"Reconstruct and group the current certificate, without solving.\"\"\"\nimport hashlib\nimport json\n\nimport numpy as np\nimport pepflow as pf\n\nfrom certificates import certificate_digest, revalidate\n\n\ndef check_certificate(certificate, notebook_dir):\n    assert certificate_digest(certificate) == certificate[\"certificate_id\"]\n    assert certificate[\"closed_form_search\"][\"completed\"]\n    assert certificate[\"certificate_provenance\"][\"pep_type\"] == \"primal\"\n    for path, expected in certificate[\"certificate_provenance\"][\"source_hashes\"].items():\n        source = (notebook_dir / path).resolve()\n        assert source.is_relative_to(notebook_dir)\n        assert hashlib.sha256(source.read_bytes()).hexdigest() == expected\n    assert json.loads(certificate[\"params_json\"]) == {\"L\": 1, \"R\": 1}\n    assert certificate[\"N\"] == certificate[\"N_verify\"]\n    ctx, pb, obj, pm, checked, residuals = revalidate(certificate)\n    pb.set_relaxed_constraints(certificate[\"relaxed_constraints\"])\n    basis = ctx.basis_vectors()\n    labels = [str(v) for v in basis]\n    assert labels == certificate[\"S_row_names\"] == certificate[\"S_col_names\"]\n    S = np.asarray(certificate[\"S_matrix\"], dtype=float)\n    assert S.shape == (len(basis), len(basis)) and np.all(np.isfinite(S))\n    assert np.allclose(S, S.T, atol=1e-6, rtol=0)\n    decomposition = certificate[\"numerical_decomposition\"]\n    D, E = np.asarray(decomposition[\"D\"]), np.asarray(decomposition[\"ell_coords\"])\n    assert decomposition[\"basis_labels\"] == labels\n    assert np.all(np.isfinite(D)) and np.all(np.isfinite(E))\n    assert np.allclose(E.T @ D @ E, S, atol=1e-4, rtol=1e-5)\n    constraints = [*pb.init_conditions, *obj.get_interpolation_constraints(ctx)]\n    groups = ctx.get_constraint_data(obj)\n    group_names = {c.name: str(group) for group, family in groups.sc_dict.items() for c in family}\n    assert not groups.psd_dict and not ctx.oper_to_duplets and len(ctx.func_to_triplets) == 1\n    weighted_terms = {}\n    for constraint in constraints:\n        initial = constraint.name == certificate[\"tau_name\"]\n        expected = dict(origin=\"initial\" if initial else \"interpolation\", owner=None if initial else str(obj), group=group_names.get(constraint.name), kind=\"scalar\", comparator=constraint.cmp.value, shape=[], relaxed=constraint.name in certificate[\"relaxed_constraints\"])\n        assert expected == certificate[\"constraint_metadata\"][constraint.name]\n        value = certificate[\"named_dual_values\"][constraint.name]\n        if expected[\"relaxed\"]:\n            assert value is None\n            continue\n        assert value is not None and value >= -1e-6\n        residual = constraint.lhs - constraint.rhs\n        if constraint.cmp == pf.Comparator.GE:\n            residual = -residual\n        weighted_terms[constraint.name] = value * residual\n    assert certificate[\"tau_sol\"] == certificate[\"named_dual_values\"][certificate[\"tau_name\"]]\n    assert certificate[\"normalization\"][\"bound_value\"] == certificate[\"opt_value\"]\n    return ctx, pb, obj, pm, weighted_terms, residuals\n\n\n\nctx, pb, obj, pm, weighted_terms, residuals = check_certificate(certificate, notebook_dir)\n",
  "decomposition_code": "basis = ctx.basis_vectors()\n\nmatrix = np.asarray(certificate[\"S_matrix\"])\nS_scalar = sum((float(matrix[i, j])*basis[i]*basis[j] for i,j in np.ndindex(matrix.shape)), pf.Scalar.zero())\n# Keep the complete numerical PSD block as the single terminal S piece.\nS_piece_terms = {\"terminal_S\": S_scalar}\nS_assignment = {\"terminal_S\": \"boundary\"}\n",
  "grouping_code": "def build_partial_sums(certificate, notebook_dir):\n    ctx, pb, obj, pm, weighted_terms, residuals = check_certificate(certificate, notebook_dir)\n    n = certificate[\"N\"]\n    basis = ctx.basis_vectors()\n    matrix = np.asarray(certificate[\"S_matrix\"])\n    S_scalar = sum((float(matrix[i, j])*basis[i]*basis[j] for i,j in np.ndindex(matrix.shape)), pf.Scalar.zero())\n    # Keep the complete numerical PSD block as the single terminal S piece.\n    S_piece_terms = {\"terminal_S\": S_scalar}\n    S_assignment = {\"terminal_S\": \"boundary\"}\n    group_terms = {name: term for name, term in weighted_terms.items() if name != certificate[\"tau_name\"]}\n    term_assignment = {}\n    for k in range(n):\n        tag = \"z_0\" if k == 0 else f\"x_{k}\"\n        term_assignment[f\"f:x_star,{tag}\"] = k\n        term_assignment[f\"f:{tag},x_{k+1}\"] = k\n    term_assignment[f\"f:x_star,x_{n}\"] = \"boundary\"\n    assert set(term_assignment) == set(group_terms)\n    lyap = [pf.Scalar.zero()]\n    partial_sum = pf.Scalar.zero()\n    for k in range(n):\n        increment = sum((group_terms[name] for name, step in term_assignment.items() if step == k), pf.Scalar.zero())\n        partial_sum += increment\n        lyap.append(partial_sum)\n    ranks, singular_values, evaluated = [], [], []\n    for k, Vk in enumerate(lyap):\n        value = pm.eval_scalar(Vk)\n        evaluated.append(value)\n        singular = np.linalg.svd(np.asarray(value.inner_prod_coords, dtype=float), compute_uv=False)\n        singular_values.append(singular.tolist())\n        rank = int(np.count_nonzero(singular > 1e-4))\n        ranks.append(rank)\n        print(f\"rank V_{k}: {rank}\")\n        if k == 0:\n            print()\n    print(\"Interior rank is constant at this N:\", len(set(ranks[2:n+1])) == 1 and n-1 >= 3, \"boundary exclusions:\", (2,0))\n    leftover = group_terms[f\"f:x_star,x_{n}\"] - S_scalar\n    coverage = lyap[n] + leftover - (sum(group_terms.values(),pf.Scalar.zero())-S_scalar)\n    expressions = [coverage, sum(S_piece_terms.values(), pf.Scalar.zero())-S_scalar]\n    for k in range(n):\n        increment = sum((group_terms[name] for name, step in term_assignment.items() if step == k),pf.Scalar.zero())\n        expressions.append(lyap[k+1]-lyap[k]-increment)\n    coverage_max = 0.\n    for expression in expressions:\n        value = pm.eval_scalar(expression)\n        for coords in (value.inner_prod_coords,value.func_coords,np.asarray(value.offset)):\n            error = float(np.max(np.abs(np.asarray(coords,dtype=float)),initial=0))\n            coverage_max = max(coverage_max,error)\n            assert error <= 1e-5\n    assert np.linalg.eigvalsh(matrix).min() >= -1e-6\n    rank_credible = all(not any(1e-5 < s < 1e-3 for s in singular) for singular in singular_values)\n    observation = dict(N=n, certificate_id=certificate[\"certificate_id\"], recipe_id=\"star-and-forward-pair-whole-S-boundary\", rank_profile=ranks, singular_values=singular_values, rank_convention=dict(tolerance=1e-4, scaling=\"absolute, no rescaling\", coordinate_order=\"setup basis creation order\"), rank_credible=rank_credible, certificate_checked=True, grouping_checked=True, coverage_max_abs=coverage_max)\n    coordinates = dict(lyap_inner_prod_coords=[np.asarray(v.inner_prod_coords,dtype=float).tolist() for v in evaluated], lyap_func_coords=[np.asarray(v.func_coords,dtype=float).tolist() for v in evaluated], lyap_offsets=[float(v.offset) for v in evaluated])\n    coverage_record = dict(constraint_assignment=term_assignment,S_assignment=S_assignment,normalization_constraint=certificate[\"tau_name\"], boundary_constraints=[f\"f:x_star,x_{n}\"], boundary_S=[\"terminal_S\"], omitted_constraints=[], checked=True)\n    return observation, coordinates, coverage_record\n\nobservation, coordinates, grouping_coverage = build_partial_sums(certificate, notebook_dir)\n",
